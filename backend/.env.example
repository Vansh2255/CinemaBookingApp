# Copy this file to .env and replace every placeholder with your own secret.
PORT=5000
NODE_ENV=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=movie_reservation
DATABASE_URL=postgresql://postgres:replace-with-a-strong-password@localhost:5432/movie_reservation?schema=public

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=inr

# Brevo SMTP (or another SMTP provider)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=your-brevo-login
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_FROM=no-reply@your-verified-domain.com
APP_BASE_URL=http://localhost:3000

# Rate limiting (per IP, per 15-minute window — these are the defaults, override if needed)
AUTH_RATE_LIMIT=10
BOOKING_RATE_LIMIT=20
PAYMENT_RATE_LIMIT=20
API_RATE_LIMIT=100

# Number of reverse-proxy hops to trust (0 = no proxy / local dev, 1 = behind nginx/ALB)
TRUST_PROXY_HOPS=0
